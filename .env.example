# Copy this file to .env and edit it. .env is never committed.

# Language model. "ollama" runs locally on your Mac; "mock" is an offline
# keyword heuristic used for testing (no real judgment).
LLM_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct

# Embeddings. "ollama" uses a local embedding model; "hash" is a crude
# offline fallback for testing.
EMBEDDING_PROVIDER=ollama
OLLAMA_EMBED_MODEL=nomic-embed-text

# Where the app stores its vector database and saved reviews (on your Mac).
DATA_DIR=./data

# OCR for scanned pages and screenshots (requires: brew install tesseract)
OCR_ENABLED=true

# Score "Unable to verify" items like "Missing" (flagged provisional for the TA to check)
UNVERIFIED_AS_MISSING=true

# Speed. LLM_PARALLEL requirements are judged at the same time; Ollama must allow it too
# (OLLAMA_NUM_PARALLEL, see the README). OLLAMA_NUM_CTX is the prompt room in tokens.
LLM_PARALLEL=2
OLLAMA_NUM_CTX=8192
# Submissions up to this many characters are sent whole, so the model reads them once per
# student instead of once per requirement (much faster). Longer ones are searched. 0 = always search.
WHOLE_SUBMISSION_CHARS=12000

# Accuracy: before anything counts against a student, re-check it against only the most related
# passages. Adds a model call for each item not judged "Met" on the first reading.
SECOND_LOOK=true

# Retrieval
TOP_K=6
CHUNK_CHARS=900
CHUNK_OVERLAP=150
