# Copy this file to .env and edit it. .env is never committed.

# Language model. "ollama" runs locally on your Mac; "mock" is an offline
# keyword heuristic used for testing (no real judgment).
LLM_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct

# Embeddings. "ollama" uses a local embedding model; "hash" is a crude
# offline fallback for testing.
EMBEDDING_PROVIDER=ollama
OLLAMA_EMBED_MODEL=nomic-embed-text

# Where the app stores its vector database and saved reviews (on your Mac).
DATA_DIR=./data

# OCR for scanned pages and screenshots (requires: brew install tesseract)
OCR_ENABLED=true

# Score "Unable to verify" items like "Missing" (flagged provisional for the TA to check)
UNVERIFIED_AS_MISSING=true

# Retrieval
TOP_K=6
CHUNK_CHARS=900
CHUNK_OVERLAP=150
